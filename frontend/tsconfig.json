{
   "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "..",
    "types": ["vuetify"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts", 
    "src/**/*.tsx",
    "src/**/*",
    "src/**/*.vue",
    "../shared/**/*"],
}